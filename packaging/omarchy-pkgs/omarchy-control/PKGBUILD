# Maintainer: Jason Alexander

pkgname=omarchy-control
pkgver=0.6.0
pkgrel=1
pkgdesc='One searchable place to understand this computer, change its settings, and reach the right tool'
arch=('x86_64' 'aarch64')
url='https://github.com/last-refuge/omarchy-control'
license=('MIT' 'OFL-1.1')
options=('!debug')
# curl is run by the updater and qt6-wayland is loaded at start, so namcap cannot see either.
depends=(
  'curl'
  'glibc'
  'hicolor-icon-theme'
  'libarchive'
  'libgcc'
  'libstdc++'
  'python'
  'systemd'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
)
optdepends=(
  'bluez-utils: Bluetooth settings'
  'git: saving versions of My Omarchy profiles'
  'github-cli: publishing My Omarchy profiles to GitHub'
  'networkmanager: network settings'
  'pipewire-pulse: sound settings'
)
makedepends=('gcc' 'make')
_omarchy_ui_commit=2f35eaef42d333c59bbfde146e4139ad4ff034c9
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "omarchy-ui-$_omarchy_ui_commit.tar.gz::https://github.com/omacom/omarchy-ui/archive/$_omarchy_ui_commit.tar.gz")
sha256sums=('1e5d5fb5416c3e4cc28862f02afac19b16909acffdd560160a056699867a47d9'
            '306f087aa56bda23235c60a12fca9b83ff67919635bcb563e357baef3251affe')

prepare() {
  local root="$srcdir/$pkgname-$pkgver"
  local ui="$srcdir/omarchy-ui-$_omarchy_ui_commit"
  # The GitHub tag archive omits submodule contents. Some published tags predate the kit.
  if [[ -f "$root/.gitmodules" ]] && grep -Fxq '[submodule "third_party/omarchy-ui"]' "$root/.gitmodules"; then
    mkdir -p "$root/third_party/omarchy-ui"
    cp -a "$ui/qt" "$ui/LICENSE" "$root/third_party/omarchy-ui/"
  fi
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  # Published older tarballs predate the shared payload. Keep their pinned
  # checksum intact; releases containing the lifecycle code stage it here.
  if [[ -f tools/agent-lifecycle/stage-payload.py ]]; then
    /usr/bin/python3 tools/agent-lifecycle/stage-payload.py --destination "$pkgdir" --binary build/omarchy-control
  else
    install -Dm755 build/omarchy-control "$pkgdir/usr/bin/omarchy-control"
  fi
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  if [[ -f third_party/omarchy-ui/LICENSE ]]; then
    install -Dm644 third_party/omarchy-ui/LICENSE "$pkgdir/usr/share/licenses/$pkgname/Omarchy-UI-LICENSE"
  fi
  install -Dm644 src/fonts/Inter-LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/Inter-LICENSE.txt"
  install -Dm644 pkgbuild/omarchy-control.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-control.svg"
  install -Dm644 pkgbuild/omarchy-control-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/omarchy-control-symbolic.svg"
  install -Dm644 pkgbuild/omarchy-control.desktop "$pkgdir/usr/share/applications/omarchy-control.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
