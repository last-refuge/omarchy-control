pkgname=omarchy-control
pkgver=0.4.0
pkgrel=1
pkgdesc='One searchable place to understand this computer, change its settings, and reach the right tool'
arch=('x86_64' 'aarch64')
url='https://github.com/last-refuge/omarchy-control'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'hicolor-icon-theme' 'curl' 'libarchive')
optdepends=('omarchy: the desktop this manages'
            'hyprland: window, input, and display settings'
            'networkmanager: network settings'
            'pipewire-pulse: sound settings'
            'bluez-utils: Bluetooth settings'
            'git: saving versions of My Omarchy profiles'
            'github-cli: publishing My Omarchy profiles to GitHub')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omarchy-control "$pkgdir/usr/bin/omarchy-control"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/fonts/Inter-LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/Inter-LICENSE.txt"
  install -Dm644 "$startdir/omarchy-control.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-control.svg"
  install -Dm644 "$startdir/omarchy-control-symbolic.svg" "$pkgdir/usr/share/icons/hicolor/symbolic/apps/omarchy-control-symbolic.svg"
  install -Dm644 "$startdir/omarchy-control.desktop" "$pkgdir/usr/share/applications/omarchy-control.desktop"
}
